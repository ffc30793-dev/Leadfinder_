# ============================================================
# LeadFinder — variáveis de ambiente (configure na Vercel:
# Project > Settings > Environment Variables). NUNCA coloque
# valores reais neste arquivo nem faça commit de um .env.
# ============================================================

# --- Obrigatórias para a busca e para os limites no servidor ---
# JSON da conta de serviço do Firebase Admin (Firebase > Configurações do projeto > Contas de serviço).
# Cole o JSON inteiro em uma linha (ou em base64).
FIREBASE_SERVICE_ACCOUNT=

# Chave do Google Places API (New). Restrinja por API no Google Cloud.
GOOGLE_PLACES_API_KEY=

# --- Opcional ---
# Segredo para assinar a "continuação" de resultados. Se vazio, deriva da conta de serviço.
CURSOR_SECRET=

# --- Cakto (preencher quando tiver as credenciais) ---
# Links de checkout (https) dos planos pagos. Sem eles o botão de assinar fica desativado.
CAKTO_PRO_CHECKOUT=
CAKTO_MAX_CHECKOUT=

# Segredo do webhook. Sem ele o webhook recusa qualquer evento.
CAKTO_WEBHOOK_SECRET=

# IDs de produto/oferta da Cakto de cada plano (separados por vírgula). Produto não listado nunca ativa plano.
CAKTO_PRODUCT_PRO=
CAKTO_PRODUCT_MAX=

# Nome do cabeçalho de assinatura HMAC, se a Cakto usar esse método (padrão: x-cakto-signature).
CAKTO_SIGNATURE_HEADER=
